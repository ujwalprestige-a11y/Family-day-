# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (keep secrets out of git)
.env
.env.*
!.env.example

# database artifacts
/prisma/*.db
/prisma/*.db-journal
/.pgdata/
/pgdata/

# master data (contains employee PII — never commit)
# Ignore the whole data directory, plus spreadsheets anywhere in the tree.
/data/
*.csv
*.xlsx
*.xls

# ...except the API route directory that is literally named "export.xlsx",
# which the *.xlsx rule above would otherwise swallow.
!app/api/admin/export.xlsx/
!app/api/admin/export.xlsx/**

# typescript
*.tsbuildinfo
next-env.d.ts

# test / coverage
/coverage
