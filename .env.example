# ---------------------------------------------------------------------------
# Prestige Family Day 2026 – Registration Desk : environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
#
# LOCAL (embedded Postgres started by `npm run db:local`, no Docker needed):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/familyday?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/familyday?schema=public"
#
# PRODUCTION (Supabase): use the project's *pooled* connection string for
# DATABASE_URL and the non-pooled 5432 connection for DIRECT_URL (migrations):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# App gate — the static username + password for the /login page.
#
# The whole app (kiosk AND admin) is unreachable until someone signs in with
# these, so they MUST be set in every environment. If either is missing the
# server fails closed and nobody can sign in.
# ---------------------------------------------------------------------------
AUTH_USERNAME="familyday"
AUTH_PASSWORD="set-this-in-.env-do-not-commit-it"

# Admin desk PIN (used on the /admin sign-in screen — a second, separate gate).
ADMIN_PIN="2026"

# Secret used to sign both session cookies. Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Confirmation email (SMTP). Leave SMTP_HOST unset to disable emails entirely.
# The app sends a confirmation on every successful registration / walk-in,
# "from" MAIL_FROM, using these SMTP credentials.
#
# Microsoft 365 example: host smtp.office365.com, port 587, secure false
# Google Workspace example: host smtp.gmail.com, port 587, secure false (use an App Password)
# ---------------------------------------------------------------------------
MAIL_FROM="amar.v@prestigeconstructions.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="amar.v@prestigeconstructions.com"
SMTP_PASS=""
